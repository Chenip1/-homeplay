page{background:#fcf4e8;color:#503522;font-size:28rpx}
.play{padding:28rpx 28rpx 60rpx;box-sizing:border-box}
.hero{background:#f8e3c2;border-radius:32rpx;padding:32rpx;margin-bottom:24rpx}
.eyebrow{font-size:24rpx;font-weight:700;color:#895525;letter-spacing:2rpx}
.title{font-size:48rpx;font-weight:800;margin:8rpx 0}
.name{font-size:32rpx;font-weight:700}
.muted{font-size:25rpx;color:#795f48;line-height:1.55;margin-top:8rpx}
.card{padding:26rpx;background:#fffdf8;border-radius:26rpx;margin:0 0 20rpx;box-shadow:0 8rpx 24rpx #92603215}
.entry,.row{display:flex;align-items:center;gap:20rpx}
.entry{min-height:100rpx}.chevron{margin-left:auto;font-size:46rpx;color:#895525}
.badge{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;border-radius:24rpx;background:#fae4bd;font-size:44rpx;flex-shrink:0}
.mint{background:#e3edd9}.blue{background:#e2edf3}
.action,.quiet,.choice{font-size:28rpx;margin:16rpx 0 0;border-radius:20rpx;line-height:1.4;padding:18rpx 20rpx;box-sizing:border-box}
.action{background:#a95722;color:#fff;font-weight:700}.quiet,.choice{background:#f6ebdc;color:#624023}.choice{text-align:left}
.back{margin:0 0 20rpx}.notice{min-height:32rpx;margin-top:16rpx;color:#895525}.question{margin:12rpx 0 20rpx}
button::after{border:0}.row button{flex:1}

