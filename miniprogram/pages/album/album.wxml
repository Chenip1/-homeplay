<view class="play">
  <button class="quiet back" bindtap="goBack">‹ 返回首页</button>
  <view class="hero">
    <view class="eyebrow">小窝里的瞬间</view>
    <view class="title">萌宠相册</view>
    <view class="muted">{{total}} 张照片</view>
  </view>
  <view class="card" wx:if="{{!total}}">
    <view class="name">还没有照片</view>
    <view class="muted">点首页的相机，就能把小窝里的这一刻存下来。</view>
  </view>
  <view class="card" wx:for="{{groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="id">
    <view class="name">{{group.name}}</view>
    <view class="muted">{{group.photos.length}} 张照片</view>
    <view class="photo-grid">
      <view wx:for="{{group.photos}}" wx:for-item="photo" wx:key="id" data-group="{{groupIndex}}" data-path="{{photo.path}}" bindtap="preview">
        <image class="photo" src="{{photo.path}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="muted">{{photo.date}}</view>
      </view>
    </view>
  </view>
</view>
