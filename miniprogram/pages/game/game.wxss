@import "../../styles/play.wxss";
.link-board{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8rpx;margin:22rpx 0}
.tile{display:flex;align-items:center;justify-content:center;height:82rpx;background:#f9e9d0;border-radius:12rpx;font-size:39rpx}
.tile.empty{background:#fbf5ec}.tile.lit{background:#ffcf7c;box-shadow:inset 0 0 0 3rpx #aa5a24}

