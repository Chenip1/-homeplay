@import "../../styles/play.wxss";

.dex-stats,.tier{display:flex;justify-content:space-between;align-items:center;gap:12rpx}
.dex-stats{font-size:26rpx;font-weight:700;margin:16rpx 0}
.tier{margin:30rpx 4rpx 16rpx}.tier .muted{margin:0}
.dex-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}
.breed{margin:0;padding:16rpx;min-width:0;display:flex;flex-direction:column}
.portrait{position:relative;overflow:hidden;width:176rpx;height:220rpx;max-width:100%;margin:0 auto 12rpx;border-radius:18rpx;background:#fff5e5}
.atlas{position:absolute;width:500%;height:400%;display:block}
.breed-info{display:flex;flex-wrap:wrap;gap:6rpx 10rpx;align-items:center;flex:1}
.breed-name{font-size:27rpx;font-weight:700}
.breed-status{font-size:20rpx;padding:4rpx 10rpx;border-radius:14rpx;color:#795f48;background:#f6ebdc}
.breed-status.owned{color:#3f5a36;background:#e4eedc}
.breed-cost{font-size:23rpx;color:#895525;margin-top:8rpx}
.dex-button{width:100%;font-size:25rpx;padding:10rpx 6rpx;margin-top:10rpx}
.dex-button[disabled]{color:#795f48;background:#f5ebdd}

