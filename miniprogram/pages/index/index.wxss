page,.page-shell{width:100vw;height:100vh;overflow:hidden;background:#2c2319}
.page-shell{display:flex;align-items:center;justify-content:center}
.home-frame{position:relative;width:100vw;height:177.7778vw;max-width:56.25vh;max-height:100vh;overflow:hidden;background:#2c2319}
.bg{position:absolute;inset:0;width:100%;height:100%}

.petStatus{position:absolute;top:5%;left:4.5%;width:67%;box-sizing:border-box;padding:12rpx 16rpx 14rpx;border-radius:22rpx;background:rgba(255,249,231,.94);box-shadow:0 6rpx 20rpx rgba(64,39,20,.15);z-index:3}
.petStatusAlert{background:rgba(255,239,225,.96)}
.statusHeader{display:flex;align-items:center;gap:10rpx;min-width:0;margin-bottom:7rpx}
.statusName{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#543820;font-size:27rpx;line-height:1.2;font-weight:700}
.editMark{display:block;flex-shrink:0;color:#90592d;font-size:24rpx;line-height:1.2}
.statusWarn{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#96392c;font-size:18rpx;line-height:1.4;margin-bottom:3rpx}
.statusRow{display:flex;align-items:center;gap:12rpx}
.statusRow+.statusRow{margin-top:7rpx}
.statusMain{flex:1;min-width:0}
.statusMeta{display:flex;align-items:center;justify-content:space-between;gap:6rpx;margin-bottom:3rpx;white-space:nowrap}
.statusTitle,.statusValue{font-size:18rpx;line-height:1.15;color:#674932}
.statusTitle{font-weight:700}
.statusLow{color:#973831}
.statusBar{height:9rpx;border-radius:999rpx;overflow:hidden;background:#eadbc8}
.statusFill{height:100%;border-radius:999rpx}
.moodFill{background:#e68c9d}
.hungerFill{background:#e6a646}
.alertFill{background:#ce6761}
.plusBtn{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;flex-shrink:0;border-radius:50%;background:#efcea0;color:#68401f;font-size:26rpx;font-weight:700}

.petStage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;transform:translateY(4.5%)}
.pet{width:48%;height:48%}
.petPortrait{position:relative;width:39%;height:27.42%;overflow:hidden;border-radius:32rpx;background:#fff5e5;box-shadow:0 10rpx 22rpx #5f351f40}
.petAtlas{position:absolute;width:500%;height:400%}
.dogCanvas{position:absolute;width:58%;height:36%;pointer-events:none}
.dogHidden{opacity:0}
.dogTarget{position:absolute;left:30%;top:39%;width:40%;height:25%;box-sizing:border-box;border-radius:38rpx}
.dogTarget.dressReady{border:3rpx dashed #ffe5a9;background:#f7d79333}
.dogTarget text{position:absolute;left:50%;bottom:-25rpx;transform:translateX(-50%);padding:4rpx 14rpx;white-space:nowrap;border-radius:30rpx;background:#fff1ce;color:#663c24;font-size:21rpx;font-weight:700}

.homeMenu{position:absolute;display:flex;flex-direction:column;align-items:center;gap:12rpx;width:15%;z-index:2}
.homeMenu.left{left:3.5%;top:26%}
.homeMenu.left .toolIcon{height:86rpx}
.homeMenu.right{right:4%;top:8%}
.homeTool{position:relative;width:100%;display:flex;flex-direction:column;align-items:center}
.toolIcon{display:block;width:100%;height:102rpx}
.toolLabel{font-size:19rpx;line-height:1.3;color:#fff6db;text-shadow:0 1px 3px #4b2919,0 0 4px #4b2919;font-weight:700;white-space:nowrap}
.mutedIcon{opacity:.55}
.yardDropZone{position:absolute;left:0;right:0;bottom:0;height:33.333%;z-index:1}
.yardItem{position:absolute;width:16%;height:27%;transform:translate(-50%,-50%)}
.yardItem.dragging{z-index:1}
.badge{position:absolute;top:4%;right:0;min-width:26rpx;height:26rpx;padding:0 5rpx;box-sizing:border-box;border-radius:999rpx;background:#ac403c;color:#fff;font-size:17rpx;line-height:26rpx;text-align:center}
.captureCanvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;pointer-events:none}
.loading{height:100vh;display:flex;align-items:center;justify-content:center;color:#fff5e5}

