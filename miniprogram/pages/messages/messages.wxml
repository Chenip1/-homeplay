<view class="wrap" wx:if="{{state}}">
  <view class="topbar">
    <button class="backBtn" bindtap="goBack">返回首页</button>
    <view class="pageTitle">消息通知</view>
  </view>

  <view class="empty" wx:if="{{state.messages.list.length === 0}}">暂无消息</view>

  <view class="item" wx:for="{{state.messages.list}}" wx:key="id">
    <view class="titleRow">
      <view class="title">{{item.title}}</view>
      <view class="dot" wx:if="{{!item.read}}"></view>
    </view>
    <view class="content">{{item.content}}</view>
    <view class="time">{{item.time}}</view>
  </view>
</view>
