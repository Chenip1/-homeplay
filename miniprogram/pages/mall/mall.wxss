@import "../../styles/play.wxss";

.shop-hero,.section,.product{display:flex;justify-content:space-between;align-items:center;gap:20rpx}
.score-box{min-width:126rpx;padding:12rpx 16rpx;text-align:center;border-radius:22rpx;background:#fff8e9}
.score-box .muted,.section .muted{margin:0}.score{font-size:42rpx;font-weight:800;color:#9a491a}
.dex-entry{display:flex;align-items:center;gap:18rpx;width:100%;padding:14rpx 22rpx;margin:0 0 20rpx;border-radius:24rpx;background:#fff9eb;text-align:left;color:#503522;line-height:1.35}
.dex-thumb{position:relative;overflow:hidden;width:72rpx;height:90rpx;flex-shrink:0;border-radius:12rpx;background:#fff5e5}
.dex-thumb image{position:absolute;top:0;left:0;width:500%;height:400%}
.dex-label .muted{font-size:22rpx;margin-top:4rpx}
.categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx}
.category{width:100%;margin:0;padding:12rpx 4rpx;display:flex;flex-direction:column;align-items:center;gap:4rpx;border-radius:18rpx;background:#fffdf8;color:#60422c;font-size:23rpx;line-height:1.45}
.category-icon{font-size:34rpx}.category.active{background:#f5d9b1;color:#60351a;font-weight:700;box-shadow:inset 0 0 0 2rpx #c67c48}
.section{margin:26rpx 4rpx 16rpx}.product{min-height:104rpx;padding:20rpx 24rpx;margin-bottom:14rpx}
.product-main{min-width:0}.product .name{font-size:29rpx}.product .muted{font-size:22rpx}
.owned{margin-top:8rpx;font-size:22rpx;color:#795f48}
.product-side{flex-shrink:0;text-align:right}.price{font-size:32rpx;font-weight:800;color:#9a491a}.price text{font-size:20rpx;font-weight:500}
.redeem{margin-top:8rpx;padding:10rpx 16rpx;min-width:132rpx;font-size:24rpx}.redeem[disabled]{background:#f2e9dc;color:#795f48}

